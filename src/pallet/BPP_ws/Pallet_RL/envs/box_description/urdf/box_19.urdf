<?xml version="1.0"?>
<robot name="simple_box">
  <link name="baseLink">
    <inertial>
      <origin xyz="1.05 0.55 0.7"/>
      <mass value="1" />
      <inertia  ixx="0.0001" ixy="0.0"  ixz="0.0"  iyy="0.0001"  iyz="0.0"  izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="1.05 0.55 0.7"/>
      <material name = 'blue'>
        <color rgba="0 0 0.8 1"/>
      </material>
      <geometry>
        <box size="2.1 1.1 1.4"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="1.05 0.55 0.7"/>
      <geometry>
        <box size="2.1 1.1 1.4"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="baseLink">
    <material>Gazebo/red</material>
  </gazebo>
</robot>