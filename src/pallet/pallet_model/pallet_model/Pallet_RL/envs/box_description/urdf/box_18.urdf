<?xml version="1.0"?>
<robot name="simple_box">
  <link name="baseLink">
    <inertial>
      <origin xyz="1.5 1.25 0.8"/>
      <mass value="1" />
      <inertia  ixx="0.0001" ixy="0.0"  ixz="0.0"  iyy="0.0001"  iyz="0.0"  izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="1.5 1.25 0.8"/>
      <material name = 'g'>
        <color rgba="0 0.5 0 1"/>
      </material>
      <geometry>
        <box size="3 2.5 1.6"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="1.5 1.25 0.8"/>
      <geometry>
        <box size="3 2.5 1.6"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="baseLink">
    <material>Gazebo/red</material>
  </gazebo>
</robot>