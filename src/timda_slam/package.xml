<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>timda_slam</name>
  <version>0.0.0</version>
  <description>TIMDA機器人SLAM和導航包</description>
  <maintainer email="flash@todo.todo">flash</maintainer>
  <license>TODO: License declaration</license>

  <!-- 導航系統依賴項 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav2_simple_commander</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_amcl</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_smoother</depend>
  <depend>nav2_waypoint_follower</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_collision_monitor</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_navfn_planner</depend>
  
  <!-- Launch和可視化依賴項 -->
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rviz2</depend>
  
  <!-- TF和sensor依賴項 -->
  <depend>tf2</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
